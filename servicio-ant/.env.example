# Referencia de configuración. No subir un archivo real con claves.
# No escribas datos privados en este archivo.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# Cargar el secreto estable desde %APPDATA%\ConsultaEC\ant-hmac.dpapi
# mediante ConvertTo-SecureString antes de iniciar ANT. No escribirlo aquí.
REDIS_CACHE_HMAC_SECRET=
REDIS_TTL_SECONDS=86400
ANT_MODO=SIMULADO
ANT_SIMULACION_FALLA=false
ANT_SIMULACION_PUNTOS=20
ANT_TIMEOUT_MS=1200
# Opcionales: ampliar los tiempos de Redis para equipos lentos.
REDIS_TIMEOUT=3s
REDIS_CONNECT_TIMEOUT=3s
